# Copy this file to .env on the server and fill it in. Never commit .env.

# The public address of the website (used in emailed set-up and reset links)
SITE_URL=https://www.elsonwhiteconsulting.com.au
NODE_ENV=production
PORT=3000

# Where the database and uploaded reports are kept. Must be a persistent disk on your host.
DATA_DIR=/var/data/ewc

# Temporary password for candice.elsonwhite, used once by `npm run seed` (must be changed at first sign-in).
INITIAL_ADMIN_PASSWORD=

# Email. All enquiries go to ENQUIRY_TO. Microsoft 365 example shown; your IT provider may prefer a mail service.
ENQUIRY_TO=admin@elsonwhiteconsulting.com.au
MAIL_FROM=Elson White Consulting <admin@elsonwhiteconsulting.com.au>
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=admin@elsonwhiteconsulting.com.au
SMTP_PASS=
