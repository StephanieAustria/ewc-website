<article class="person">
  <div class="photo-slot" role="img" aria-label="Photo of <%= name %> to come"><span class="ini"><%= initials %></span>Professional headshot<br>to be supplied</div>
  <div>
    <h3><%= name %></h3>
    <p class="role"><%= role %></p>
    <div class="bio">
      <span class="placeholder">Biography to be supplied and approved by <%= name.split(' ')[0] %> — professional background, areas of expertise and responsibilities.</span>
    </div>
  </div>
</article>
