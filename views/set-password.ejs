<%- include('partials/head') %>
<body>
<main class="auth" id="main">
  <a class="brand" href="<%= href('/') %>"><img class="lockup" src="<%= href('/img/ewc-lockup.png') %>" alt="Elson White Consulting" width="308" height="72"></a>
  <h1>Set Your Password</h1>
  <% if (!valid) { %>
    <div class="auth-card"><div class="alert err">This link has expired or was already used. Contact admin@elsonwhiteconsulting.com.au for a new one.</div>
    <a class="btn btn-gold" href="<%= href('/login') %>">Go to sign in</a></div>
  <% } else { %>
    <p class="sub">Welcome, <%= u.name %>. Your username is <b><%= u.username %></b>.</p>
    <form class="auth-card" method="post" action="<%= href('/set-password') %>">
      <% if (error) { %><div class="alert err" role="alert"><%= error %></div><% } %>
      <input type="hidden" name="_form" value="<%= formToken() %>">
      <input type="hidden" name="token" value="<%= token %>">
      <div class="field"><%- icon('lock') %><label class="sr-only" for="password">New password</label>
        <input id="password" name="password" type="password" placeholder="New password (at least <%= min %> characters)" autocomplete="new-password" minlength="<%= min %>" required></div>
      <div class="field"><%- icon('lock') %><label class="sr-only" for="confirm">Confirm password</label>
        <input id="confirm" name="confirm" type="password" placeholder="Confirm new password" autocomplete="new-password" required></div>
      <button class="btn btn-gold" type="submit">Save password</button>
    </form>
  <% } %>
</main>
</body>
</html>
